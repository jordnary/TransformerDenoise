# Local materials: keep only empty directory placeholders in Git
/assignment/*
!/assignment/.gitkeep
/reports/*
!/reports/.gitkeep
/personal/*
!/personal/.gitkeep
# Legacy local locations remain ignored
/test.png
/submission/
/archive/
